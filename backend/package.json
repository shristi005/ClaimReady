{
  "name": "claimready-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/claimValidator.test.js tests/groundingCheck.test.js tests/auth.test.js",
    "samples": "node scripts/makeSampleClaims.js",
    "eval": "node eval/runEval.js",
    "smoke": "node scripts/smoke.js",
    "doctor": "node scripts/doctor.js",
    "build:web": "npm --prefix ../frontend install && npm --prefix ../frontend run build",
    "demo": "npm run build:web && node src/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8"
  }
}
