PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# If frontend/dist exists (npm run build in frontend), this server also serves the web app on PORT.
# WEB_DIR=

# Set to 1 when running behind Render, a tunnel, or any reverse proxy (so rate limits see the real visitor).
# TRUST_PROXY=1

# Where ClaimReady keeps its database file and uploaded documents (default: backend/data).
# Back up this folder to back up everything.
# DATA_DIR=

# Sessions: sign out after this many idle minutes, and never keep one longer than this many hours.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# AI: ollama (default, local, free) or groq (optional cloud)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=5m
LLM_TIMEOUT_MS=180000

# Optional
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

MAX_UPLOAD_MB=10
